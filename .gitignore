# PoliMusic - .gitignore

# === Secrets & Configuration ===
# Never commit real connection strings or credentials
config/secrets.asp
*.env
.env

# === Database files ===
*.mdf
*.ldf
*.bak

# === Resources (audio & images - large binary / placeholder files) ===
assets/audio/*
!assets/audio/.gitkeep
assets/images/*
!assets/images/.gitkeep

# === OS generated files ===
Thumbs.db
Desktop.ini
.DS_Store

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === IIS / ASP temp files ===
*.tmp
*.log
app_data/

# === Node / npm (if any tooling is added later) ===
node_modules/
package-lock.json
