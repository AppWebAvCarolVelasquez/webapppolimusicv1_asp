<%
'===============================================================
' config/secrets.asp  (GITIGNORED - DO NOT COMMIT)
'===============================================================
' This file is excluded from version control via .gitignore.
' Override the default database connection settings here.
'
' Copy this file to secrets.asp and fill in your real values.
'===============================================================

' --- SQL Server Instance ---
' Local default:      "localhost"
' Named instance:      "localhost\SQLEXPRESS"
' Docker:              "localhost,1433"
' Remote:              "192.168.1.100,1433"
DB_SERVER = "localhost"

' --- Database name (from the BDD_PoliMusic.sql script) ---
DB_NAME = "BDD_PoliMusic"

' --- Port (empty for default 1433) ---
DB_PORT = ""

' --- Authentication mode ---
' The BDD_PoliMusic.sql script creates a SQL login 'usr_polimusic'
' Set to False to use SQL Server Authentication with that login.
' Set to True to use Windows Authentication (trusted connection).
DB_USE_WINDOWS_AUTH = False

' --- SQL Server credentials ---
' The SQL login 'usr_polimusic' is created by BDD_PoliMusic.sql.
' Enter the password you set when running the script.
DB_USER = "usr_polimusic"
DB_PASS = "PolicMusic2025*"
%>
